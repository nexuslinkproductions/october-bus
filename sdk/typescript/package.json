{
  "name": "october-bus",
  "version": "0.1.0",
  "description": "TypeScript client for October Bus.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "October",
  "homepage": "https://github.com/october-dev/october-bus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/october-dev/october-bus.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/october-dev/october-bus/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:errors": "node test/errors.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
